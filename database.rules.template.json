{
  "rules": {
    ".read": false,
    ".write": false,
    "live": {
      ".read": "auth != null && auth.token.email == '__ALLOWED_EMAIL__' && auth.token.email_verified == true"
    },
    "presence": {
      ".read": "auth != null && auth.token.email == '__ALLOWED_EMAIL__' && auth.token.email_verified == true",
      ".write": "auth != null && auth.token.email == '__ALLOWED_EMAIL__' && auth.token.email_verified == true"
    }
  }
}
